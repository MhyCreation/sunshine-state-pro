# ── LOCALBASE (local-first backend) ──────────────────────────────────────────
# Server-side URL (used by Next.js server actions and middleware)
LOCALBASE_URL=http://localhost:7700
# Client-side URL (exposed to the browser)
NEXT_PUBLIC_LOCALBASE_URL=http://localhost:7700

# ── LOCALBASE SERVER CONFIG ───────────────────────────────────────────────────
# (Place these in a .env file next to localbase.config.json, or set in docker-compose)
LB_JWT_SECRET=change-me-to-a-long-random-secret
LB_API_KEY=your-studio-admin-key          # protects /studio/api; leave empty for open access

# ── STORAGE: local (default) or S3-compatible (R2, MinIO, AWS S3) ────────────
LB_STORAGE_TYPE=local                     # or: s3
# For Cloudflare R2:
# LB_STORAGE_TYPE=s3
# LB_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# LB_S3_REGION=auto
# LB_S3_BUCKET=localbase
# LB_S3_ACCESS_KEY=your-r2-access-key
# LB_S3_SECRET_KEY=your-r2-secret-key

NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── LATER PHASES ─────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
OPENAI_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
RESEND_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
